# Copia este archivo como .env y cambia los valores.
# El archivo .env NO se sube a Git.

# PostgreSQL
POSTGRES_USER=admin_ai
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=db_ai_models

# Usuario de solo lectura (rol analista_ro) para Spark y la pagina web.
# La contrasena debe ser la misma que se puso a app_user en 05_seguridad.sql
APP_DB_USER=app_user
APP_DB_PASSWORD=cambia_esto

# Neo4j (el usuario debe ser neo4j y la contrasena de 8 caracteres o mas)
NEO4J_USER=neo4j
NEO4J_PASSWORD=cambia_esto_8

# Databasus (cuenta de administrador de la interfaz web)
DATABASUS_NAME=admin
DATABASUS_EMAIL=correo@ejemplo.com
DATABASUS_PASSWORD=cambia_esto

# Ruta ABSOLUTA a la carpeta lab de este proyecto
PATH_JUPYTER=/ruta/completa/al/proyecto/lab

# Token para entrar a Jupyter
JUPYTER_TOKEN=cambia_esto
